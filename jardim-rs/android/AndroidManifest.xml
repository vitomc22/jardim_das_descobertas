<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.jardim.descobertas.rs"
    android:versionCode="3"
    android:versionName="0.3.0-rs">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application
        android:label="Jardim (Rust)"
        android:icon="@drawable/ic_launcher"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:theme="@style/AppTheme">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="jardim" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
